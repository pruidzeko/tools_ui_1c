#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСвойствоВТипПлафтормы(ОписаниеТипа, Имя, ИмяАнгл, МинимальнаяПлатформа, Доступность, ТипыЗначения)
	НовоеСвойство = НовыйОписаниеСвойстваТипа();
	НовоеСвойство.Имя = Имя;
	НовоеСвойство.ИмяАнгл = ИмяАнгл;
	НовоеСвойство.МинимальнаяПлатформа = МинимальнаяПлатформа;
	НовоеСвойство.Доступность = Доступность;
	НовоеСвойство.ТипыЗначения = ТипыЗначения;
	ОписаниеТипа.Свойства.Добавить(НовоеСвойство);

КонецПроцедуры

Процедура ДобавитьМетодВТипПлафтормы(ОписаниеТипа, Имя, ИмяАнгл, МинимальнаяПлатформа, Доступность)
	НовыйМетод = НовыйОписаниеМетодаТипа();
	НовыйМетод.Имя = Имя;
	НовыйМетод.ИмяАнгл = ИмяАнгл;
	НовыйМетод.МинимальнаяПлатформа = МинимальнаяПлатформа;
	НовыйМетод.Доступность = Доступность;
	ОписаниеТипа.Методы.Добавить(НовыйМетод);

КонецПроцедуры

Функция НовыйТипПлатформы(Имя, ИмяАнгл, МинимальнаяПлатформа, ЭтоКоллекция, ЭтоПеречисление, Доступность, ТипыЭлементаКоллекции)
	Описание = НовыйОписаниеТипаПлатформы();
	Описание.Имя = Имя;
	Описание.ИмяАнгл = ИмяАнгл;
	Описание.ЭтоКоллекция = ЭтоКоллекция;
	Описание.ЭтоПеречисление = ЭтоПеречисление;
	Описание.МинимальнаяПлатформа = МинимальнаяПлатформа;
	Описание.Доступность = Доступность;
	Описание.ТипыЭлементаКоллекции =ТипыЭлементаКоллекции;
	
	Возврат Описание;
КонецФункции
