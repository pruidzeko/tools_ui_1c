//Этот модуль был сгененрирован автоматически после разбора синтаксис помощника платформы
//Используется последняя релизная(стабильная, тестовые версии опускаются) версия, 
//доступная на момент выхода релиза инструментов


#Область ПрограммныйИнтерфейс

// Описание типа платформы по имени.
// 
// Параметры:
//  ИмяТипа - Строка- Имя типа
// 
// Возвращаемое значение:
//  см. НовыйОписаниеТипаПлатформы
// Возвращаемое значение:
//  Неопределено - описания для такого типа нет
Функция ОписаниеТипаПлатформыПоИмени(ИмяТипа) Экспорт
	ИмяПроцедурыОписанияТипа = "ОписаниеТипаПлатформы"+ИмяТипа;
	
	Попытка
		//@skip-check server-execution-safe-mode
		Возврат Вычислить(ИмяПроцедурыОписанияТипа+"()");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Новый описание типа платформы.
// 
// Возвращаемое значение:
//  Структура - Новый описание типа платформы:
// * Имя - Строка - 
// * ИмяАнгл - Строка - 
// * МинимальнаяПлатформа - Строка - 
// * ЭтоКоллекция - Булево - 
// * ЭтоПеречисление - Булево - 
// * ТипыЭлементаКоллекции - Строка - 
// * Доступность - Строка- 
// * Свойства - Массив из см. НовыйОписаниеСвойстваТипа - 
// * Значения - Массив из см. НовыйОписаниеЗначенияТипа- 
// * Методы - Массив из см. НовыйОписаниеМетодаТипа- 
// * Конструкторы - Массив из см. НовыйОписаниеКонструктораТипа- 
Функция НовыйОписаниеТипаПлатформы() Экспорт
	Описание = Новый Структура;
	Описание.Вставить("Имя", "");
	Описание.Вставить("ИмяАнгл", "");
	Описание.Вставить("МинимальнаяПлатформа", "");
	Описание.Вставить("ЭтоКоллекция", Ложь);
	Описание.Вставить("ЭтоПеречисление", Ложь);
	Описание.Вставить("ТипыЭлементаКоллекции", "");
	Описание.Вставить("Доступность", "");
	Описание.Вставить("Свойства", Новый Массив);
	Описание.Вставить("Значения", Новый Массив);
	Описание.Вставить("Методы", Новый Массив);
	Описание.Вставить("Конструкторы", Новый Массив);
	
	Возврат Описание;
КонецФункции

// Новый описание свойства типа.
// 
// Возвращаемое значение:
//  Структура - Новый описание свойства типа:
// * Имя - Строка - 
// * ИмяАнгл - Строка - 
// * МинимальнаяПлатформа - Строка - 
// * Доступность - Строка - 
// * ТипыЗначения - Строка- 
Функция НовыйОписаниеСвойстваТипа() Экспорт
